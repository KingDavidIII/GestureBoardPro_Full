{
  "name": "gestureboardpro-frontend",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.10.10",
    "eslint": "^9.39.4",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
